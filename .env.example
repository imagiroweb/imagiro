# Backend (optionnel en dev local)
PORT=3001
MONGODB_URI=mongodb://localhost:27017

# Authentification JWT (à changer en production)
JWT_SECRET=change-me-in-production

# SSO Google (optionnel) — créer des identifiants dans Google Cloud Console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# URLs pour redirections (dev: backend 3001, frontend 5173)
# BACKEND_URL=http://localhost:3001
# FRONTEND_URL=http://localhost:5173

# En Docker, MONGODB_URI est défini par docker-compose
